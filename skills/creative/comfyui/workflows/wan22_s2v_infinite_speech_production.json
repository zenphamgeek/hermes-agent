{
  "_meta": {
    "title": "Wan2.2-S2V-14B Production: Chained Infinite Speech (Multi-Chunk)",
    "description": "Infinite multi-chunk speech-to-video chaining using WanSoundImageToVideo followed by WanSoundImageToVideoExtend. Preserves character visual identity, lighting, and head pose across clause boundaries.",
    "model": "Wan2.2-S2V-14B",
    "aspect_ratio": "16:9 (1024x704 base)",
    "tier": "NVIDIA A100-80GB"
  },
  "1": {
    "class_type": "UNETLoader",
    "_meta": { "title": "Load Wan2.2 S2V 14B UNET Foundation" },
    "inputs": {
      "unet_name": "wan2.2_s2v_14B_bf16.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "_meta": { "title": "Load UMT5-XXL Text Encoder" },
    "inputs": {
      "clip_name": "umt5_xxl_fp16.safetensors",
      "type": "wan"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "_meta": { "title": "Load Wan 2.1 VAE" },
    "inputs": {
      "vae_name": "wan_2.1_vae.safetensors"
    }
  },
  "4": {
    "class_type": "AudioEncoderLoader",
    "_meta": { "title": "Load Speech Audio Encoder" },
    "inputs": {
      "audio_encoder_name": "audio_encoder.safetensors"
    }
  },
  "5": {
    "class_type": "LoadAudio",
    "_meta": { "title": "Chunk 1 Audio (TTS V0-Sense Clause 1)" },
    "inputs": {
      "audio": "clause_01_speech.wav"
    }
  },
  "6": {
    "class_type": "LoadAudio",
    "_meta": { "title": "Chunk 2 Audio (TTS V0-Sense Clause 2)" },
    "inputs": {
      "audio": "clause_02_speech.wav"
    }
  },
  "7": {
    "class_type": "LoadImage",
    "_meta": { "title": "Anchor Portrait Image" },
    "inputs": {
      "image": "masterclass_anchor.png"
    }
  },
  "8": {
    "class_type": "AudioEncoderEncode",
    "_meta": { "title": "Encode Chunk 1 Audio Embeddings" },
    "inputs": {
      "audio_encoder": ["4", 0],
      "audio": ["5", 0]
    }
  },
  "9": {
    "class_type": "AudioEncoderEncode",
    "_meta": { "title": "Encode Chunk 2 Audio Embeddings" },
    "inputs": {
      "audio_encoder": ["4", 0],
      "audio": ["6", 0]
    }
  },
  "10": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Positive Continuous Speech Prompt" },
    "inputs": {
      "clip": ["2", 0],
      "text": "A distinguished professor lecturing continuously with natural fluid head kinematics, calm eye contact, warm ambient studio lighting, hyperrealistic 8k, neo-noir dark background"
    }
  },
  "11": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Negative Prompt (Anti-Jitter & Drift)" },
    "inputs": {
      "clip": ["2", 0],
      "text": "distorted teeth, unnatural mouth movements, blurry, jittery, low quality, artifacting, eye drift, morphing lips, identity shift, sudden head jump"
    }
  },
  "12": {
    "class_type": "WanSoundImageToVideo",
    "_meta": { "title": "Chunk 1 Latent Conditioning" },
    "inputs": {
      "positive": ["10", 0],
      "negative": ["11", 0],
      "vae": ["3", 0],
      "width": 1024,
      "height": 704,
      "length": 81,
      "batch_size": 1,
      "audio_encoder_output": ["8", 0],
      "ref_image": ["7", 0]
    }
  },
  "13": {
    "class_type": "ModelSamplingSD3",
    "_meta": { "title": "Flow Match Sampling Shift" },
    "inputs": {
      "model": ["1", 0],
      "shift": 3.0
    }
  },
  "14": {
    "class_type": "KSampler",
    "_meta": { "title": "KSampler Chunk 1 Denoise" },
    "inputs": {
      "model": ["13", 0],
      "positive": ["12", 0],
      "negative": ["12", 1],
      "latent_image": ["12", 2],
      "seed": 2024,
      "steps": 35,
      "cfg": 5.0,
      "sampler_name": "uni_pc",
      "scheduler": "simple",
      "denoise": 1.0
    }
  },
  "15": {
    "class_type": "WanSoundImageToVideoExtend",
    "_meta": { "title": "Chunk 2 Latent Extension (Zero-Seam Chaining)" },
    "inputs": {
      "positive": ["10", 0],
      "negative": ["11", 0],
      "vae": ["3", 0],
      "length": 81,
      "video_latent": ["14", 0],
      "audio_encoder_output": ["9", 0],
      "ref_image": ["7", 0]
    }
  },
  "16": {
    "class_type": "KSampler",
    "_meta": { "title": "KSampler Chunk 2 Extension Denoise" },
    "inputs": {
      "model": ["13", 0],
      "positive": ["15", 0],
      "negative": ["15", 1],
      "latent_image": ["15", 2],
      "seed": 2025,
      "steps": 35,
      "cfg": 5.0,
      "sampler_name": "uni_pc",
      "scheduler": "simple",
      "denoise": 1.0
    }
  },
  "17": {
    "class_type": "VAEDecode",
    "_meta": { "title": "Decode Extended Multi-Chunk Latents" },
    "inputs": {
      "samples": ["16", 0],
      "vae": ["3", 0]
    }
  },
  "18": {
    "class_type": "FaceRestoreModelLoader",
    "_meta": { "title": "Load CodeFormer / GFPGAN Face Restorer" },
    "inputs": {
      "model_name": "codeformer.pth"
    }
  },
  "19": {
    "class_type": "FaceRestoreCFWithModel",
    "_meta": { "title": "Face Enhancer (Continuous Multi-Chunk Facial Detailer)" },
    "inputs": {
      "facerestore_model": ["18", 0],
      "image": ["17", 0],
      "fidelity": 0.85
    }
  },
  "20": {
    "class_type": "CreateVideo",
    "_meta": { "title": "Create Video from Extended Enhanced Frames & Spoken Audio" },
    "inputs": {
      "images": ["19", 0],
      "audio": ["5", 0],
      "fps": 25.0
    }
  },
  "21": {
    "class_type": "SaveVideo",
    "_meta": { "title": "Save Chained Speech Video" },
    "inputs": {
      "video": ["20", 0],
      "filename_prefix": "wan22_s2v_infinite_chained_speech",
      "format": "auto",
      "codec": "auto"
    }
  }
}
