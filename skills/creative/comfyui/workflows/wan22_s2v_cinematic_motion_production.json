{
  "_meta": {
    "title": "Wan2.2-S2V-14B Production: Cinematic Motion & Dramatic Lighting",
    "description": "High-dynamism speech-to-video for dramatic masterclass openers and philosophical climaxes. Incorporates camera push-in kinematics, micro-expression intensity shifts, and Neo-Noir studio aesthetics.",
    "model": "Wan2.2-S2V-14B",
    "aspect_ratio": "16:9 (1024x704 base / 1080p upscale)",
    "tier": "NVIDIA A100-80GB"
  },
  "1": {
    "class_type": "UNETLoader",
    "_meta": { "title": "Load Wan2.2 S2V 14B UNET Foundation" },
    "inputs": {
      "unet_name": "wan2.2_s2v_14B_bf16.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "_meta": { "title": "Load UMT5-XXL Text Encoder" },
    "inputs": {
      "clip_name": "umt5_xxl_fp16.safetensors",
      "type": "wan"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "_meta": { "title": "Load Wan 2.1 VAE" },
    "inputs": {
      "vae_name": "wan_2.1_vae.safetensors"
    }
  },
  "4": {
    "class_type": "AudioEncoderLoader",
    "_meta": { "title": "Load Speech Audio Encoder" },
    "inputs": {
      "audio_encoder_name": "audio_encoder.safetensors"
    }
  },
  "5": {
    "class_type": "LoadAudio",
    "_meta": { "title": "Dramatic Spoken Audio (TTS V0-Sense 48kHz)" },
    "inputs": {
      "audio": "dramatic_voiceover.wav"
    }
  },
  "6": {
    "class_type": "LoadImage",
    "_meta": { "title": "Cinematic Anchor Portrait" },
    "inputs": {
      "image": "cinematic_portrait_16x9.png"
    }
  },
  "7": {
    "class_type": "AudioEncoderEncode",
    "_meta": { "title": "Extract Audio Prosody & Phonemes" },
    "inputs": {
      "audio_encoder": ["4", 0],
      "audio": ["5", 0]
    }
  },
  "8": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Positive Cinematic Drama Prompt" },
    "inputs": {
      "clip": ["2", 0],
      "text": "Cinematic slow camera dolly push-in on a visionary Vietnamese thinker speaking with intense intellectual conviction, expressive eye movements, deep furrowed brow relaxing into revelation, volumetric moody atmosphere, Neo-Noir obsidian background, 35mm anamorphic lens, 8k masterclass visual quality"
    }
  },
  "9": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Negative Prompt (Anti-Artifact & Anti-Plastic)" },
    "inputs": {
      "clip": ["2", 0],
      "text": "distorted teeth, unnatural mouth movements, blurry, jittery, low quality, artifacting, cartoon, plastic skin, flat lighting, static mannequin pose, jittery camera"
    }
  },
  "10": {
    "class_type": "WanSoundImageToVideo",
    "_meta": { "title": "Cinematic Latent Conditioning" },
    "inputs": {
      "positive": ["8", 0],
      "negative": ["9", 0],
      "vae": ["3", 0],
      "width": 1024,
      "height": 704,
      "length": 81,
      "batch_size": 1,
      "audio_encoder_output": ["7", 0],
      "ref_image": ["6", 0]
    }
  },
  "11": {
    "class_type": "ModelSamplingSD3",
    "_meta": { "title": "Flow Match Sampling Shift (High Kinematic Shift)" },
    "inputs": {
      "model": ["1", 0],
      "shift": 3.5
    }
  },
  "12": {
    "class_type": "KSampler",
    "_meta": { "title": "KSampler Cinematic Diffusion (40 Steps)" },
    "inputs": {
      "model": ["11", 0],
      "positive": ["10", 0],
      "negative": ["10", 1],
      "latent_image": ["10", 2],
      "seed": 9999,
      "steps": 40,
      "cfg": 5.5,
      "sampler_name": "uni_pc",
      "scheduler": "simple",
      "denoise": 1.0
    }
  },
  "13": {
    "class_type": "VAEDecode",
    "_meta": { "title": "Decode Cinematic Latents" },
    "inputs": {
      "samples": ["12", 0],
      "vae": ["3", 0]
    }
  },
  "14": {
    "class_type": "FaceRestoreModelLoader",
    "_meta": { "title": "Load CodeFormer / GFPGAN Face Restorer" },
    "inputs": {
      "model_name": "codeformer.pth"
    }
  },
  "15": {
    "class_type": "FaceRestoreCFWithModel",
    "_meta": { "title": "Face Enhancer (Micro-Detail, Eyes & Teeth Restoration)" },
    "inputs": {
      "facerestore_model": ["14", 0],
      "image": ["13", 0],
      "fidelity": 0.85
    }
  },
  "16": {
    "class_type": "CreateVideo",
    "_meta": { "title": "Create Video from Enhanced Frames & Spoken Audio" },
    "inputs": {
      "images": ["15", 0],
      "audio": ["5", 0],
      "fps": 25.0
    }
  },
  "17": {
    "class_type": "SaveVideo",
    "_meta": { "title": "Mux Pristine Cinematic 16:9 MP4" },
    "inputs": {
      "video": ["16", 0],
      "filename_prefix": "wan22_s2v_cinematic_motion_16x9",
      "format": "auto",
      "codec": "auto"
    }
  }
}
