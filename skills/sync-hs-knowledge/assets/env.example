# HS Knowledge Sync Environment Configuration
# Target: P15 LXD Infrastructure (default) or Standalone Docker Compose

# Database (PostgreSQL 16 + pgvector)
# For P15 LXD: postgresql://postgres:postgres_p15_2026@10.123.214.220:5432/hs_knowledge
# For local Docker: postgresql://hs_user:hs_password@localhost:5432/hs_knowledge
HS_DATABASE_URL=postgresql://hs_user:hs_password@localhost:5432/hs_knowledge

# Redis Queue & Broker
# For P15 LXD: redis://:redis_p15_2026@10.123.214.184:6379/0
# For local Docker: redis://localhost:6379/0
HS_REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO S3)
# For P15 LXD: http://10.123.214.249:9000
# For local Docker: http://localhost:9000
HS_OBJECT_ENDPOINT=http://localhost:9000
HS_OBJECT_BUCKET=hs-knowledge-raw
HS_OBJECT_ACCESS_KEY=minio_admin
HS_OBJECT_SECRET_KEY=minio_password
HS_OBJECT_REGION=us-east-1

# LLM / Embedding Provider
# For P15 LXD LM Studio: http://10.123.214.1:1234/v1
HS_EMBEDDING_PROVIDER=lmstudio
HS_EMBEDDING_ENDPOINT=http://10.123.214.1:1234/v1
HS_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# Source Registry Path
HS_SOURCE_REGISTRY_PATH=references/source-catalog.yaml

# Logging & Resilience
HS_LOG_LEVEL=INFO
HS_RESILIENCE_LAB_ENABLED=false
HS_RESILIENCE_LAB_ALLOWED_HOSTS=localhost,127.0.0.1
